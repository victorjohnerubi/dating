# Copy to .env for local development. Never commit .env or real credentials.
PORT=3000
NODE_ENV=development

# Optional locally; required in production for persistent profiles and chats.
MONGODB_URI=

# Optional locally; configure for AI replies.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Set a long random value in production. Local development uses data/session-secret.
SESSION_SECRET=
